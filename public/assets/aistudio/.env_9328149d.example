# AI Presentation Platform — environment variables
# Copy to .env.local and fill in real values. Never commit .env.local.

# Runtime accepts development, test or production only. Production disables
# mock checkout/webhooks and mock entitlements until a real provider is built.
NODE_ENV=development
# Loopback by default. Set another listener only for an authorized deployment.
HOST=127.0.0.1
# Optional exact CORS origin. Production defaults to same-origin proxy use.
# FRONTEND_ORIGIN=https://your-authorized-frontend.example
# Remote PostgreSQL always verifies TLS. URL sslmode flags cannot disable it.
# If your provider uses a private CA, supply its trusted PEM file here.
# PGSSL_CA_FILE=C:/secure-config/provider-root-ca.pem

# Supabase project serving this app's data in the isolated `ai_presentation`
# schema (a SHARED project — do not touch public.htkis_* / public.unreal_bs_*).
SUPABASE_URL=                     # from: supabase dashboard > Project Settings > API
SUPABASE_ANON_KEY=                # publishable/anon key — safe for client-side use
# SUPABASE_SERVICE_ROLE_KEY: SECRET, server-side only — see where it's actually
# used below (the background worker), with the full explanation of why.

# Direct Postgres connection (for the app's own backend, bypassing PostgREST).
# Use the "Session pooler" connection string from Database > Connection string
# in the dashboard. Requires the database password set at project creation —
# reset it there if you don't have it, then fill this in yourself.
DATABASE_URL=                     # postgresql://postgres.<ref>:<password>@<pooler-host>:5432/postgres

# A SEPARATE role for webhook handling only (BYPASSRLS — webhooks have no
# Supabase Auth session to apply RLS against; the HMAC signature IS the
# security boundary, verified in application code before any DB write).
# Keep this credential distinct from DATABASE_URL so a leak of one doesn't
# grant the other's privileges.
WEBHOOK_DATABASE_URL=

# A THIRD separate role for the background job worker (BYPASSRLS — it claims
# jobs across ALL users, not one authenticated request, so it cannot use the
# per-request SET ROLE authenticated + request.jwt.claims pattern). Its own
# credential, distinct from both roles above.
WORKER_DATABASE_URL=

# The worker needs this to complete a job's storage upload when there is no
# live user session to act on behalf of (e.g. recovering a job after a crash,
# or any retry that happens later than the original request). Without it,
# the worker still claims/leases/retries jobs for real - it just fails the
# upload step every time and correctly backs off, which is itself a real,
# observable exercise of the retry mechanism. Get it from the dashboard
# yourself (Project Settings > API > service_role) — never paste it into
# chat with an AI assistant.
SUPABASE_SERVICE_ROLE_KEY=

# Python interpreter used to run engine/generate_static_deck.py as a
# subprocess. On Windows, plain "python3"/"python" may resolve to a broken
# Microsoft Store stub — point this at a real install if so.
PYTHON_BIN=python3

# No real payment provider is connected (see docs/BLOCKERS.md #2). This is an
# explicitly-labeled sandbox/mock provider, not SSLCOMMERZ — it proves the
# real checkout -> webhook -> entitlement mechanics without pretending a
# live integration exists. Generate your own secret, e.g.:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PAYMENT_PROVIDER=mock_sandbox
MOCK_PAYMENT_WEBHOOK_SECRET=

# AI drafting uses Puter.js in the browser with the user's Puter account.
# No direct OpenAI or other provider API key is required by the studio.
# This does not configure server generation or authorize live provider usage.

# Remote integration tests are OFF by default. Enable only for an authorized,
# isolated test target after reviewing fixture cleanup/pricing/storage effects.
# The production/journey suites require a separately running worker.
# ALLOW_REMOTE_INTEGRATION_TESTS=1
# INTEGRATION_TEST_SUPABASE_URL=<exact configured SUPABASE_URL>
# INTEGRATION_TEST_DATABASE_HOST=<hostname shared by all three DB connections>
# INTEGRATION_TEST_USER_A_EMAIL=
# INTEGRATION_TEST_USER_A_PASSWORD=
# INTEGRATION_TEST_USER_B_EMAIL=
# INTEGRATION_TEST_USER_B_PASSWORD=

# Optional local PostgreSQL bin directory for npm run test:jobs:local.
# PG_TEST_BIN=C:/Program Files/PostgreSQL/17/bin

# Real Static preview worker dependencies. Explicit executables on the worker;
# keep unavailable when absent. LibreOffice rendering is not PowerPoint QA.
# PREVIEW_LIBREOFFICE_BIN=C:/path/to/LibreOffice/program/soffice.com
# PREVIEW_PDFTOPPM_BIN=C:/path/to/pdftoppm.exe
