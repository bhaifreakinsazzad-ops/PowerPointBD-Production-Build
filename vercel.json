{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npm ci --include=dev && npm --prefix frontend ci --include=dev",
  "buildCommand": "npm run build:vercel",
  "outputDirectory": "frontend/dist",
  "cleanUrls": true,
  "functions": {
    "api/index.mjs": {
      "includeFiles": "supabase-ca.crt",
      "maxDuration": 30
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/index.mjs" }
  ],
  "headers": [
    {
      "source": "/sw.js",
      "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
    }
  ]
}
